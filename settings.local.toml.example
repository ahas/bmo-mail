# Copied to settings.local.toml by a deployment, with its own values. Any key left out keeps the value
# settings.toml gives it; BMO_MAIL_<TABLE>__<KEY> in the environment overrides both.

[server]
listen = "127.0.0.1:3330"
token = "mail-token"

[store]
path = "/srv/bmo-mail/mail.db"

[accounts]
# The accounts file this instance imports once, and the administrator's owner key the imported accounts
# stand under. A development instance names its own, never a deployment's.
file = "/srv/bmo-mail/env/mail-accounts"
administrator = "administrator"

[secrets]
# The key file the accounts' secrets are sealed with: 32 random bytes as base64 on one line.
key_file = "/srv/bmo-mail/env/mail-secrets.key"

[staging]
dir = "/srv/bmo-mail/mail-staging"
