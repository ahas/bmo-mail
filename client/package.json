  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "nuxt.config.ts",
    "console-bundle.json",
    "app",
    "shared",
    "i18n"
  ],
  "scripts": {
    "prepare": "bun x nuxi prepare",
    "openapi": "openapi-typescript ../docs/openapi.json --output shared/openapi.ts",
    "bundle": "nuxi prepare && vite build --config console/vite.config.ts",
    "typecheck": "nuxi prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && tsc -p console/tsconfig.json",
    "check": "bun install --frozen-lockfile && bun run typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.2",
    "@tiptap/extension-table": "3.32.0",
