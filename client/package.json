    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vue-i18n": "^11.4.8",
    "vue-tsc": "^3.2.0"
  }
}
