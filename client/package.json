    "@tiptap/vue-3": "3.32.0",
    "bmo-text": "file:../../../base/text/package",
    "dompurify": "3.4.8",
    "vue": "^3.5.24",
    "vue-router": "^5.2.0"
  },
  "peerDependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "bmo-ui": "0.1.0-rev.18",
    "nuxt": "^4.5.2",
    "vue-i18n": "^11.4.8"
  },
  "peerDependenciesMeta": {
    "bmo-ui": {
      "optional": true
    }
  },
