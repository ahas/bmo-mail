  "type": "module",
  "scripts": {
    "prepare": "bun x nuxi prepare",
    "openapi": "openapi-typescript ../docs/openapi.json --output shared/openapi.ts",
    "bundle": "nuxi prepare && vite build --config console/vite.config.ts",
    "typecheck": "nuxi prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && tsc -p console/tsconfig.json && tsc -p tests/tsconfig.json",
    "check": "bun install --frozen-lockfile && bun run typecheck && bun test"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.2",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "bmo-text": "file:vendor/bmo-text-0.1.0-rev.5-f5874fb.tgz",
    "dompurify": "3.4.8",
    "vue": "^3.5.24",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.3.4",
    "@vitejs/plugin-vue": "6.0.10",
    "bmo-ui": "file:vendor/bmo-ui-0.1.0-rev.62.tgz",
    "nuxt": "^4.5.2",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vue-i18n": "^11.4.8",
    "vue-tsc": "^3.2.0"
  },
  "patchedDependencies": {
    "@nuxt/icon@2.5.1": "patches/@nuxt%2Ficon@2.5.1.patch",
    "reka-ui@2.11.0": "patches/reka-ui@2.11.0.patch",
    "@nuxt/ui@4.12.2": "patches/@nuxt%2Fui@4.12.2.patch"
  }
}
